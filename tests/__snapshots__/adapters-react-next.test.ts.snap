  --shadow-raised: 0 1px 2px rgba(0, 0, 0, 0.4);
  --shadow-overlay: 0 8px 24px rgba(0, 0, 0, 0.5);
}

/* No JavaScript and no explicit choice: follow the system setting */
@media (prefers-color-scheme: dark) {
