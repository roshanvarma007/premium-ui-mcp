"// Generated by premium-ui-mcp from the "fintech-trust" design direction (v1).
// Use these tokens everywhere; do not hardcode colors, sizes, radii or fonts in screens.
// Prefer CSS classes; use these for inline styles, CSS-in-JS, or chart and canvas colors.

/** Colors as CSS variables: they switch with the theme automatically. */
export const color = {
  bg: 'var(--color-bg)',
  surface: 'var(--color-surface)',
  surfaceAlt: 'var(--color-surface-alt)',
  text: 'var(--color-text)',
  textMuted: 'var(--color-text-muted)',
  border: 'var(--color-border)',
  borderStrong: 'var(--color-border-strong)',
  accent: 'var(--color-accent)',
  onAccent: 'var(--color-on-accent)',
  link: 'var(--color-link)',
  success: 'var(--color-success)',
  warning: 'var(--color-warning)',
  error: 'var(--color-error)',
  onSuccess: 'var(--color-on-success)',
  onWarning: 'var(--color-on-warning)',
  onError: 'var(--color-on-error)',
};

/** Spacing scale (4px grid). Key = multiples of the base unit. */
export const space = {
  0: 'var(--spacing-0)',
  1: 'var(--spacing-1)',
  2: 'var(--spacing-2)',
  3: 'var(--spacing-3)',
  4: 'var(--spacing-4)',
  6: 'var(--spacing-6)',
  8: 'var(--spacing-8)',
  12: 'var(--spacing-12)',
  16: 'var(--spacing-16)',
  24: 'var(--spacing-24)',
};

export const radius = {
  sm: 'var(--radius-sm)',
  md: 'var(--radius-md)',
  lg: 'var(--radius-lg)',
  full: 'var(--radius-full)',
};

/** Typography roles. Spread into a style: style={{ ...text.body }} */
export const text = {
  display: {
    fontFamily: 'var(--font-display)',
    fontSize: 'var(--text-display)',
    lineHeight: 'var(--text-display--line-height)',
    letterSpacing: 'var(--text-display--letter-spacing)',
    fontWeight: 'var(--text-display--font-weight)',
  },
  headline: {
    fontFamily: 'var(--font-display)',
    fontSize: 'var(--text-headline)',
    lineHeight: 'var(--text-headline--line-height)',
    letterSpacing: 'var(--text-headline--letter-spacing)',
    fontWeight: 'var(--text-headline--font-weight)',
  },
  title: {
    fontFamily: 'var(--font-body)',
    fontSize: 'var(--text-title)',
    lineHeight: 'var(--text-title--line-height)',
    letterSpacing: 'var(--text-title--letter-spacing)',
    fontWeight: 'var(--text-title--font-weight)',
  },
  body: {
    fontFamily: 'var(--font-body)',
    fontSize: 'var(--text-body)',
    lineHeight: 'var(--text-body--line-height)',
    letterSpacing: 'var(--text-body--letter-spacing)',
    fontWeight: 'var(--text-body--font-weight)',
  },
  bodySmall: {
    fontFamily: 'var(--font-body)',
    fontSize: 'var(--text-body-small)',
    lineHeight: 'var(--text-body-small--line-height)',
    letterSpacing: 'var(--text-body-small--letter-spacing)',
    fontWeight: 'var(--text-body-small--font-weight)',
  },
  label: {
    fontFamily: 'var(--font-body)',
    fontSize: 'var(--text-label)',
    lineHeight: 'var(--text-label--line-height)',
    letterSpacing: 'var(--text-label--letter-spacing)',
    fontWeight: 'var(--text-label--font-weight)',
  },
  caption: {
    fontFamily: 'var(--font-body)',
    fontSize: 'var(--text-caption)',
    lineHeight: 'var(--text-caption--line-height)',
    letterSpacing: 'var(--text-caption--letter-spacing)',
    fontWeight: 'var(--text-caption--font-weight)',
  },
};

export const motion = {
  fastMs: 120,
  baseMs: 200,
  slowMs: 320,
  easing: 'cubic-bezier(0.2, 0, 0, 1)',
};

/** Raw hex values, only for places CSS variables cannot reach (canvas, charts, emails). */
export const palette = {
  light: {
    bg: '#F7F6F3',
    surface: '#FFFFFF',
    surfaceAlt: '#F0EEE9',
    text: '#16181D',
    textMuted: '#5F636A',
    border: '#E4E1DA',
    borderStrong: '#8C8A84',
    accent: '#0F6B4F',
    onAccent: '#FFFFFF',
    link: '#0F6B4F',
    success: '#1F7A3D',
    warning: '#975700',
    error: '#B3261E',
    onSuccess: '#FFFFFF',
    onWarning: '#FFFFFF',
    onError: '#FFFFFF',
  },
  dark: {
    bg: '#111314',
    surface: '#181B1C',
    surfaceAlt: '#202425',
    text: '#ECEAE4',
    textMuted: '#A3A7A6',
    border: '#2A2F30',
    borderStrong: '#666C6B',
    accent: '#5CC49B',
    onAccent: '#08201A',
    link: '#5CC49B',
    success: '#6BCB86',
    warning: '#E6A955',
    error: '#F28B82',
    onSuccess: '#181B1C',
    onWarning: '#181B1C',
    onError: '#181B1C',
  },
};

/**
 * Inline this in <head> before any stylesheet (or in the root layout) so the saved or system
