exports[`nextjs adapter > matches snapshots (ts and js, app and pages) > js/pages/styles/globals.css 1`] = `
"@import "./tokens.css";

/* Generated by premium-ui-mcp from the "fintech-trust" design direction (v1).
 * Use these tokens everywhere; do not hardcode colors, sizes, radii or fonts in screens.
 * Modern reset, base typography, focus and reduced-motion handling.
 */

*,
*::before,
*::after {
  box-sizing: border-box;
}

* {
  margin: 0;
}

html {
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}

body {
  min-height: 100dvh;
  background: var(--color-bg);
  color: var(--color-text);
  font-family: var(--font-body);
  font-size: var(--text-body);
  line-height: var(--text-body--line-height);
  letter-spacing: var(--text-body--letter-spacing);
  font-weight: var(--text-body--font-weight);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  font-variant-numeric: tabular-nums;
}

img,
picture,
video,
canvas,
svg {
  display: block;
  max-width: 100%;
}

input,
button,
textarea,
select {
  font: inherit;
  color: inherit;
}

h1,
h2,
h3,
h4 {
  text-wrap: balance;
}

p {
  text-wrap: pretty;
}

a {
  color: var(--color-link);
  text-underline-offset: 0.2em;
}

::selection {
  background: var(--color-accent);
  color: var(--color-on-accent);
}

/* Visible keyboard focus everywhere; never remove it without this replacement. */
:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 2px;
  border-radius: var(--radius-sm);
}

/* Typography roles: use these instead of ad-hoc font sizes. */
.t-display {
  font-family: var(--font-display);
  font-size: var(--text-display);
  line-height: var(--text-display--line-height);
  letter-spacing: var(--text-display--letter-spacing);
  font-weight: var(--text-display--font-weight);
}

.t-headline {
  font-family: var(--font-display);
  font-size: var(--text-headline);
  line-height: var(--text-headline--line-height);
  letter-spacing: var(--text-headline--letter-spacing);
  font-weight: var(--text-headline--font-weight);
}

.t-title {
  font-family: var(--font-body);
  font-size: var(--text-title);
  line-height: var(--text-title--line-height);
  letter-spacing: var(--text-title--letter-spacing);
  font-weight: var(--text-title--font-weight);
}

.t-body {
  font-family: var(--font-body);
  font-size: var(--text-body);
  line-height: var(--text-body--line-height);
  letter-spacing: var(--text-body--letter-spacing);
  font-weight: var(--text-body--font-weight);
}

.t-body-small {
  font-family: var(--font-body);
  font-size: var(--text-body-small);
  line-height: var(--text-body-small--line-height);
  letter-spacing: var(--text-body-small--letter-spacing);
  font-weight: var(--text-body-small--font-weight);
}

.t-label {
  font-family: var(--font-body);
  font-size: var(--text-label);
  line-height: var(--text-label--line-height);
  letter-spacing: var(--text-label--letter-spacing);
  font-weight: var(--text-label--font-weight);
}

.t-caption {
  font-family: var(--font-body);
  font-size: var(--text-caption);
  line-height: var(--text-caption--line-height);
  letter-spacing: var(--text-caption--letter-spacing);
  font-weight: var(--text-caption--font-weight);
}

.t-muted {
  color: var(--color-text-muted);
}

/* Numbers that line up in tables, balances and prices. */
.num {
  font-variant-numeric: tabular-nums;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* Components that follow the direction rules. */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-2);
  min-height: var(--size-touch);
  padding: 0 var(--spacing-4);
  border: 1px solid transparent;
  border-radius: var(--radius-md);
  font-family: var(--font-body);
  font-size: var(--text-body-small);
  line-height: 1;
  font-weight: var(--text-title--font-weight);
  text-decoration: none;
  cursor: pointer;
  transition:
    background-color var(--duration-fast) var(--ease-standard),
    border-color var(--duration-fast) var(--ease-standard),
    color var(--duration-fast) var(--ease-standard);
}

.btn-primary {
  background: var(--color-accent);
  color: var(--color-on-accent);
}

.btn-primary:hover {
  background: color-mix(in srgb, var(--color-accent) 88%, var(--color-text));
}

.btn-secondary {
  background: transparent;
  border-color: var(--color-border-strong);
  color: var(--color-text);
}

.btn-secondary:hover {
  background: var(--color-surface-alt);
}

.card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--spacing-6);
}

.field {
  display: grid;
  gap: var(--spacing-2);
}

.field label {
  font-size: var(--text-label);
  line-height: var(--text-label--line-height);
  letter-spacing: var(--text-label--letter-spacing);
  font-weight: var(--text-label--font-weight);
}

.input {
  min-height: var(--size-touch);
  padding: 0 var(--spacing-3);
  background: var(--color-surface);
  border: 1px solid var(--color-border-strong);
  border-radius: var(--radius-md);
}

.divider {
  border: 0;
  border-top: 1px solid var(--color-border);
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
"
`;

exports[`nextjs adapter > matches snapshots (ts and js, app and pages) > js/pages/styles/tokens.css 1`] = `
"/* Generated by premium-ui-mcp from the "fintech-trust" design direction (v1).
 * Use these tokens everywhere; do not hardcode colors, sizes, radii or fonts in screens.
 */

:root {
  color-scheme: light dark;
  --color-bg: #F7F6F3;
  --color-surface: #FFFFFF;
  --color-surface-alt: #F0EEE9;
  --color-text: #16181D;
  --color-text-muted: #5F636A;
  --color-border: #E4E1DA;
  --color-border-strong: #8C8A84;
  --color-accent: #0F6B4F;
  --color-on-accent: #FFFFFF;
  --color-link: #0F6B4F;
  --color-success: #1F7A3D;
  --color-warning: #975700;
  --color-error: #B3261E;
  --color-on-success: #FFFFFF;
  --color-on-warning: #FFFFFF;
  --color-on-error: #FFFFFF;
  --shadow-raised: 0 1px 2px rgba(22, 24, 29, 0.06);
  --shadow-overlay: 0 8px 24px rgba(22, 24, 29, 0.12);

  /* Font families */
  --font-display: var(--nf-fraunces), Georgia, "Times New Roman", serif;
  --font-body: var(--nf-manrope), system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --font-mono: var(--nf-jetbrains-mono), ui-monospace, SFMono-Regular, Consolas, monospace;

  /* Type scale: size, line height, letter spacing, weight per role */
  --text-display: clamp(2rem, 1.413rem + 2.6087vw, 3.5rem);
  --text-display--line-height: 1.2;
  --text-display--letter-spacing: -0.02em;
  --text-display--font-weight: 600;
  --text-headline: clamp(1.5rem, 1.2065rem + 1.3043vw, 2.25rem);
  --text-headline--line-height: 1.2857;
  --text-headline--letter-spacing: -0.01em;
  --text-headline--font-weight: 600;
  --text-title: 1.125rem;
  --text-title--line-height: 1.3333;
  --text-title--letter-spacing: 0em;
  --text-title--font-weight: 600;
  --text-body: 1rem;
  --text-body--line-height: 1.5;
  --text-body--letter-spacing: 0em;
  --text-body--font-weight: 400;
  --text-body-small: 0.875rem;
  --text-body-small--line-height: 1.4286;
  --text-body-small--letter-spacing: 0em;
  --text-body-small--font-weight: 400;
  --text-label: 0.75rem;
  --text-label--line-height: 1.3333;
  --text-label--letter-spacing: 0.02em;
  --text-label--font-weight: 500;
  --text-caption: 0.75rem;
  --text-caption--line-height: 1.3333;
  --text-caption--letter-spacing: 0.01em;
  --text-caption--font-weight: 400;

  /* Spacing (4px grid; name = multiples of the base) */
  --spacing-0: 0;
  --spacing-1: 0.25rem;
  --spacing-2: 0.5rem;
  --spacing-3: 0.75rem;
  --spacing-4: 1rem;
  --spacing-6: 1.5rem;
  --spacing-8: 2rem;
  --spacing-12: 3rem;
  --spacing-16: 4rem;
  --spacing-24: 6rem;

  /* Radii. Buttons and inputs md, cards md, sheets and dialogs lg, chips and avatars full. Never mix more than 3 radii on one screen. */
  --radius-sm: 0.375rem;
  --radius-md: 0.75rem;
  --radius-lg: 1rem;
  --radius-full: 9999px;

  /* Motion */
  --ease-standard: cubic-bezier(0.2, 0, 0, 1);
  --duration-fast: 120ms;
  --duration-base: 200ms;
  --duration-slow: 320ms;

  /* Accessibility */
  --size-touch: 2.75rem; /* 44px minimum target */
}

/* Dark theme: explicit choice via <html data-theme="dark"> */
:root[data-theme='dark'] {
  color-scheme: dark;
  --color-bg: #111314;
  --color-surface: #181B1C;
  --color-surface-alt: #202425;
