  --text-caption: 0.75rem;
  --text-caption--line-height: 1.3333;
  --text-caption--letter-spacing: 0.01em;
  --text-caption--font-weight: 400;

  /* Spacing (4px grid; name = multiples of the base) */
  --spacing-0: 0;
  --spacing-1: 0.25rem;
  --spacing-2: 0.5rem;
  --spacing-3: 0.75rem;
  --spacing-4: 1rem;
  --spacing-6: 1.5rem;
  --spacing-8: 2rem;
  --spacing-12: 3rem;
  --spacing-16: 4rem;
