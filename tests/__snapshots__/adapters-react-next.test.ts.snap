  --text-headline: clamp(1.5rem, 1.2065rem + 1.3043vw, 2.25rem);
  --text-headline--line-height: 1.2857;
  --text-headline--letter-spacing: -0.01em;
  --text-headline--font-weight: 600;
  --text-title: 1.125rem;
  --text-title--line-height: 1.3333;
  --text-title--letter-spacing: 0em;
  --text-title--font-weight: 600;
  --text-body: 1rem;
  --text-body--line-height: 1.5;
  --text-body--letter-spacing: 0em;
  --text-body--font-weight: 400;
  --text-body-small: 0.875rem;
  --text-body-small--line-height: 1.4286;
  --text-body-small--letter-spacing: 0em;
  --text-body-small--font-weight: 400;
  --text-label: 0.75rem;
