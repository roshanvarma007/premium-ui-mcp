exports[`tailwind adapter > matches snapshots > css/base.css 1`] = `
"/* Generated by premium-ui-mcp from the "fintech-trust" design direction (v1).
 * Use these tokens everywhere; do not hardcode colors, sizes, radii or fonts in screens.
 * Modern reset, base typography, focus and reduced-motion handling.
 */

*,
*::before,
*::after {
  box-sizing: border-box;
}

* {
  margin: 0;
}

html {
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}

body {
  min-height: 100dvh;
  background: var(--color-bg);
  color: var(--color-text);
  font-family: var(--font-body);
  font-size: var(--text-body);
  line-height: var(--text-body--line-height);
  letter-spacing: var(--text-body--letter-spacing);
  font-weight: var(--text-body--font-weight);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  font-variant-numeric: tabular-nums;
}

img,
picture,
video,
canvas,
svg {
  display: block;
  max-width: 100%;
}

input,
button,
textarea,
select {
  font: inherit;
  color: inherit;
}

h1,
h2,
h3,
h4 {
  text-wrap: balance;
}

p {
  text-wrap: pretty;
}

a {
  color: var(--color-link);
  text-underline-offset: 0.2em;
}

::selection {
  background: var(--color-accent);
  color: var(--color-on-accent);
}

/* Visible keyboard focus everywhere; never remove it without this replacement. */
:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 2px;
  border-radius: var(--radius-sm);
}

/* Typography roles: use these instead of ad-hoc font sizes. */
.t-display {
  font-family: var(--font-display);
  font-size: var(--text-display);
  line-height: var(--text-display--line-height);
  letter-spacing: var(--text-display--letter-spacing);
  font-weight: var(--text-display--font-weight);
}

.t-headline {
  font-family: var(--font-display);
  font-size: var(--text-headline);
  line-height: var(--text-headline--line-height);
  letter-spacing: var(--text-headline--letter-spacing);
  font-weight: var(--text-headline--font-weight);
}

.t-title {
  font-family: var(--font-body);
  font-size: var(--text-title);
  line-height: var(--text-title--line-height);
  letter-spacing: var(--text-title--letter-spacing);
  font-weight: var(--text-title--font-weight);
}

.t-body {
  font-family: var(--font-body);
  font-size: var(--text-body);
  line-height: var(--text-body--line-height);
  letter-spacing: var(--text-body--letter-spacing);
  font-weight: var(--text-body--font-weight);
}

.t-body-small {
  font-family: var(--font-body);
  font-size: var(--text-body-small);
  line-height: var(--text-body-small--line-height);
  letter-spacing: var(--text-body-small--letter-spacing);
  font-weight: var(--text-body-small--font-weight);
}

.t-label {
  font-family: var(--font-body);
  font-size: var(--text-label);
  line-height: var(--text-label--line-height);
  letter-spacing: var(--text-label--letter-spacing);
  font-weight: var(--text-label--font-weight);
}

.t-caption {
  font-family: var(--font-body);
  font-size: var(--text-caption);
  line-height: var(--text-caption--line-height);
  letter-spacing: var(--text-caption--letter-spacing);
  font-weight: var(--text-caption--font-weight);
}

.t-muted {
  color: var(--color-text-muted);
}

/* Numbers that line up in tables, balances and prices. */
.num {
  font-variant-numeric: tabular-nums;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* Components that follow the direction rules. */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-2);
  min-height: var(--size-touch);
  padding: 0 var(--spacing-4);
  border: 1px solid transparent;
  border-radius: var(--radius-md);
  font-family: var(--font-body);
  font-size: var(--text-body-small);
  line-height: 1;
  font-weight: var(--text-title--font-weight);
  text-decoration: none;
  cursor: pointer;
  transition:
    background-color var(--duration-fast) var(--ease-standard),
    border-color var(--duration-fast) var(--ease-standard),
    color var(--duration-fast) var(--ease-standard);
}

.btn-primary {
  background: var(--color-accent);
  color: var(--color-on-accent);
}

.btn-primary:hover {
  background: color-mix(in srgb, var(--color-accent) 88%, var(--color-text));
}

.btn-secondary {
  background: transparent;
  border-color: var(--color-border-strong);
  color: var(--color-text);
}

.btn-secondary:hover {
  background: var(--color-surface-alt);
}

.card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--spacing-6);
}

.field {
  display: grid;
  gap: var(--spacing-2);
}

.field label {
  font-size: var(--text-label);
  line-height: var(--text-label--line-height);
  letter-spacing: var(--text-label--letter-spacing);
  font-weight: var(--text-label--font-weight);
}

.input {
  min-height: var(--size-touch);
  padding: 0 var(--spacing-3);
  background: var(--color-surface);
  border: 1px solid var(--color-border-strong);
  border-radius: var(--radius-md);
}

.divider {
  border: 0;
  border-top: 1px solid var(--color-border);
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
"
`;

exports[`tailwind adapter > matches snapshots > css/fonts.css 1`] = `
"/* Generated by premium-ui-mcp from the "fintech-trust" design direction (v1).
 * Use these tokens everywhere; do not hardcode colors, sizes, radii or fonts in screens.
 * Self-hosted fonts (no third-party requests). Put the woff2 files in ../fonts/
 */

@font-face {
  font-family: "Fraunces";
  font-style: normal;
  font-weight: 600;
  font-display: swap;
  src: url("../fonts/fraunces-600.woff2") format("woff2");
}

@font-face {
  font-family: "Manrope";
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url("../fonts/manrope-400.woff2") format("woff2");
}

@font-face {
  font-family: "Manrope";
  font-style: normal;
  font-weight: 500;
  font-display: swap;
  src: url("../fonts/manrope-500.woff2") format("woff2");
}

@font-face {
  font-family: "Manrope";
  font-style: normal;
  font-weight: 600;
  font-display: swap;
  src: url("../fonts/manrope-600.woff2") format("woff2");
}

@font-face {
  font-family: "JetBrains Mono";
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url("../fonts/jetbrains-mono-400.woff2") format("woff2");
}
"
`;

exports[`tailwind adapter > matches snapshots > css/tailwind.css 1`] = `
"/* Generated by premium-ui-mcp from the "fintech-trust" design direction (v1).
 * Use these tokens everywhere; do not hardcode colors, sizes, radii or fonts in screens.
 * Tailwind CSS v4 entry. Dark mode is handled by tokens.css; dark: is rarely needed.
 */

@import "tailwindcss";
@import "./fonts.css";
@import "./tokens.css";

/* Matches the data-theme attribute that the no-flash snippet always sets. */
@custom-variant dark (&:where([data-theme=dark], [data-theme=dark] *));

@theme {
  /* Only direction colors exist: no default palette (no indigo, purple, violet...). */
  --color-*: initial;
  --color-bg: #F7F6F3;
  --color-surface: #FFFFFF;
  --color-surface-alt: #F0EEE9;
  --color-text: #16181D;
  --color-text-muted: #5F636A;
  --color-border: #E4E1DA;
  --color-border-strong: #8C8A84;
  --color-accent: #0F6B4F;
  --color-on-accent: #FFFFFF;
  --color-link: #0F6B4F;
  --color-success: #1F7A3D;
  --color-on-success: #FFFFFF;
  --color-warning: #975700;
  --color-on-warning: #FFFFFF;
  --color-error: #B3261E;
  --color-on-error: #FFFFFF;
  --color-transparent: transparent;
  --color-current: currentColor;

  --font-*: initial;
  --font-display: "Fraunces", Georgia, "Times New Roman", serif;
  --font-body: "Manrope", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Consolas, monospace;
  --default-font-family: var(--font-body);
  --default-mono-font-family: var(--font-mono);

  /* Type roles: text-display sets size, line height, tracking and weight together. */
  --text-*: initial;
  --text-display: clamp(2rem, 1.413rem + 2.6087vw, 3.5rem);
  --text-display--line-height: 1.2;
  --text-display--letter-spacing: -0.02em;
  --text-display--font-weight: 600;
  --text-headline: clamp(1.5rem, 1.2065rem + 1.3043vw, 2.25rem);
  --text-headline--line-height: 1.2857;
  --text-headline--letter-spacing: -0.01em;
  --text-headline--font-weight: 600;
  --text-title: 1.125rem;
  --text-title--line-height: 1.3333;
  --text-title--letter-spacing: 0em;
  --text-title--font-weight: 600;
  --text-body: 1rem;
  --text-body--line-height: 1.5;
  --text-body--letter-spacing: 0em;
  --text-body--font-weight: 400;
  --text-body-small: 0.875rem;
  --text-body-small--line-height: 1.4286;
  --text-body-small--letter-spacing: 0em;
  --text-body-small--font-weight: 400;
  --text-label: 0.75rem;
  --text-label--line-height: 1.3333;
  --text-label--letter-spacing: 0.02em;
  --text-label--font-weight: 500;
  --text-caption: 0.75rem;
  --text-caption--line-height: 1.3333;
  --text-caption--letter-spacing: 0.01em;
  --text-caption--font-weight: 400;

  /* Spacing: only the 4px-grid scale. p-4 = 1rem; off-grid values do not exist. */
  --spacing-*: initial;
  --spacing-0: 0;
  --spacing-1: 0.25rem;
  --spacing-2: 0.5rem;
  --spacing-3: 0.75rem;
  --spacing-4: 1rem;
  --spacing-6: 1.5rem;
  --spacing-8: 2rem;
  --spacing-12: 3rem;
  --spacing-16: 4rem;
  --spacing-24: 6rem;
  --spacing-touch: 2.75rem; /* min-h-touch / size-touch: 44px minimum target */

  --radius-*: initial;
  --radius-sm: 0.375rem;
  --radius-md: 0.75rem;
  --radius-lg: 1rem;
  --radius-full: 9999px;

  --shadow-*: initial;
  --shadow-raised: 0 1px 2px rgba(22, 24, 29, 0.06);
  --shadow-overlay: 0 8px 24px rgba(22, 24, 29, 0.12);

  /* No blur utilities: glassmorphism is not part of this direction. */
  --blur-*: initial;

  --ease-*: initial;
  --ease-standard: cubic-bezier(0.2, 0, 0, 1);
}

/* Type role shortcuts: class="t-display" sets family, size, leading, tracking and weight. */
@utility t-display {
  font-family: var(--font-display);
  font-size: var(--text-display);
  line-height: var(--text-display--line-height);
  letter-spacing: var(--text-display--letter-spacing);
  font-weight: var(--text-display--font-weight);
}

@utility t-headline {
  font-family: var(--font-display);
  font-size: var(--text-headline);
  line-height: var(--text-headline--line-height);
  letter-spacing: var(--text-headline--letter-spacing);
  font-weight: var(--text-headline--font-weight);
}

@utility t-title {
  font-family: var(--font-body);
  font-size: var(--text-title);
  line-height: var(--text-title--line-height);
  letter-spacing: var(--text-title--letter-spacing);
  font-weight: var(--text-title--font-weight);
}

@utility t-body {
  font-family: var(--font-body);
  font-size: var(--text-body);
  line-height: var(--text-body--line-height);
  letter-spacing: var(--text-body--letter-spacing);
  font-weight: var(--text-body--font-weight);
}

@utility t-body-small {
  font-family: var(--font-body);
  font-size: var(--text-body-small);
  line-height: var(--text-body-small--line-height);
  letter-spacing: var(--text-body-small--letter-spacing);
  font-weight: var(--text-body-small--font-weight);
}

@utility t-label {
  font-family: var(--font-body);
  font-size: var(--text-label);
  line-height: var(--text-label--line-height);
  letter-spacing: var(--text-label--letter-spacing);
  font-weight: var(--text-label--font-weight);
}

@utility t-caption {
  font-family: var(--font-body);
  font-size: var(--text-caption);
  line-height: var(--text-caption--line-height);
  letter-spacing: var(--text-caption--letter-spacing);
  font-weight: var(--text-caption--font-weight);
}
"
`;

exports[`tailwind adapter > matches snapshots > css/tokens.css 1`] = `
"/* Generated by premium-ui-mcp from the "fintech-trust" design direction (v1).
 * Use these tokens everywhere; do not hardcode colors, sizes, radii or fonts in screens.
 */

:root {
  color-scheme: light dark;
  --color-bg: #F7F6F3;
  --color-surface: #FFFFFF;
  --color-surface-alt: #F0EEE9;
  --color-text: #16181D;
  --color-text-muted: #5F636A;
  --color-border: #E4E1DA;
  --color-border-strong: #8C8A84;
  --color-accent: #0F6B4F;
  --color-on-accent: #FFFFFF;
  --color-link: #0F6B4F;
  --color-success: #1F7A3D;
  --color-warning: #975700;
  --color-error: #B3261E;
  --color-on-success: #FFFFFF;
  --color-on-warning: #FFFFFF;
  --color-on-error: #FFFFFF;
  --shadow-raised: 0 1px 2px rgba(22, 24, 29, 0.06);
  --shadow-overlay: 0 8px 24px rgba(22, 24, 29, 0.12);

  /* Font families */
  --font-display: "Fraunces", Georgia, "Times New Roman", serif;
  --font-body: "Manrope", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Consolas, monospace;

  /* Type scale: size, line height, letter spacing, weight per role */
  --text-display: clamp(2rem, 1.413rem + 2.6087vw, 3.5rem);
  --text-display--line-height: 1.2;
  --text-display--letter-spacing: -0.02em;
  --text-display--font-weight: 600;
  --text-headline: clamp(1.5rem, 1.2065rem + 1.3043vw, 2.25rem);
  --text-headline--line-height: 1.2857;
  --text-headline--letter-spacing: -0.01em;
  --text-headline--font-weight: 600;
  --text-title: 1.125rem;
  --text-title--line-height: 1.3333;
  --text-title--letter-spacing: 0em;
  --text-title--font-weight: 600;
  --text-body: 1rem;
  --text-body--line-height: 1.5;
  --text-body--letter-spacing: 0em;
  --text-body--font-weight: 400;
  --text-body-small: 0.875rem;
  --text-body-small--line-height: 1.4286;
  --text-body-small--letter-spacing: 0em;
  --text-body-small--font-weight: 400;
  --text-label: 0.75rem;
  --text-label--line-height: 1.3333;
  --text-label--letter-spacing: 0.02em;
  --text-label--font-weight: 500;
  --text-caption: 0.75rem;
  --text-caption--line-height: 1.3333;
  --text-caption--letter-spacing: 0.01em;
  --text-caption--font-weight: 400;

  /* Spacing (4px grid; name = multiples of the base) */
  --spacing-0: 0;
  --spacing-1: 0.25rem;
  --spacing-2: 0.5rem;
  --spacing-3: 0.75rem;
  --spacing-4: 1rem;
  --spacing-6: 1.5rem;
  --spacing-8: 2rem;
  --spacing-12: 3rem;
  --spacing-16: 4rem;
  --spacing-24: 6rem;

  /* Radii. Buttons and inputs md, cards md, sheets and dialogs lg, chips and avatars full. Never mix more than 3 radii on one screen. */
  --radius-sm: 0.375rem;
  --radius-md: 0.75rem;
  --radius-lg: 1rem;
  --radius-full: 9999px;

  /* Motion */
  --ease-standard: cubic-bezier(0.2, 0, 0, 1);
  --duration-fast: 120ms;
  --duration-base: 200ms;
  --duration-slow: 320ms;

  /* Accessibility */
  --size-touch: 2.75rem; /* 44px minimum target */
}

/* Dark theme: explicit choice via <html data-theme="dark"> */
:root[data-theme='dark'] {
  color-scheme: dark;
  --color-bg: #111314;
  --color-surface: #181B1C;
  --color-surface-alt: #202425;
  --color-text: #ECEAE4;
  --color-text-muted: #A3A7A6;
  --color-border: #2A2F30;
  --color-border-strong: #666C6B;
  --color-accent: #5CC49B;
  --color-on-accent: #08201A;
  --color-link: #5CC49B;
  --color-success: #6BCB86;
  --color-warning: #E6A955;
  --color-error: #F28B82;
  --color-on-success: #181B1C;
  --color-on-warning: #181B1C;
  --color-on-error: #181B1C;
  --shadow-raised: 0 1px 2px rgba(0, 0, 0, 0.4);
  --shadow-overlay: 0 8px 24px rgba(0, 0, 0, 0.5);
}

/* No JavaScript and no explicit choice: follow the system setting */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme]) {
    color-scheme: dark;
    --color-bg: #111314;
    --color-surface: #181B1C;
    --color-surface-alt: #202425;
    --color-text: #ECEAE4;
    --color-text-muted: #A3A7A6;
    --color-border: #2A2F30;
    --color-border-strong: #666C6B;
    --color-accent: #5CC49B;
    --color-on-accent: #08201A;
    --color-link: #5CC49B;
    --color-success: #6BCB86;
    --color-warning: #E6A955;
    --color-error: #F28B82;
    --color-on-success: #181B1C;
    --color-on-warning: #181B1C;
    --color-on-error: #181B1C;
    --shadow-raised: 0 1px 2px rgba(0, 0, 0, 0.4);
    --shadow-overlay: 0 8px 24px rgba(0, 0, 0, 0.5);
  }
}

:root[data-theme='light'] {
  color-scheme: light;
}
"
`;

exports[`tailwind adapter > matches snapshots > index.html 1`] = `
"<!doctype html>
<!-- Generated by premium-ui-mcp from the "fintech-trust" design direction (v1).
     Use these tokens everywhere; do not hardcode colors, sizes, radii or fonts in screens. -->
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Product name: what it does, for whom</title>
    <meta name="description" content="One sentence that says what this is and who it is for.">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F7F6F3">
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111314">
    <script>(function(){try{var t=localStorage.getItem('theme');if(t!=='light'&&t!=='dark'){t=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}document.documentElement.setAttribute('data-theme',t)}catch(e){}})();</script>
    <link rel="preload" href="fonts/manrope-400.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="css/fonts.css">
    <link rel="stylesheet" href="css/tokens.css">
    <link rel="stylesheet" href="css/base.css">
    <link rel="stylesheet" href="css/output.css">
    <style>
      .wrap { max-width: 72rem; margin: 0 auto; padding: 0 var(--spacing-6); }
      .stack > * + * { margin-top: var(--spacing-4); }
      .section { padding-block: var(--spacing-24); }
      .section + .section { border-top: 1px solid var(--color-border); }
      .nav { display: flex; align-items: center; justify-content: space-between; min-height: var(--spacing-16); }
      .brand { color: var(--color-text); text-decoration: none; }
      .nav-links { display: flex; align-items: center; gap: var(--spacing-6); list-style: none; padding: 0; }
      .nav-links a:not(.btn) { color: var(--color-text); text-decoration: none; }
      .hero { padding-block: var(--spacing-24) var(--spacing-16); }
      .hero > * { max-width: 44rem; }
      .hero h1 { margin-top: var(--spacing-3); }
      .lede { margin-top: var(--spacing-4); max-width: 36rem; }
      .actions { display: flex; flex-wrap: wrap; gap: var(--spacing-3); margin-top: var(--spacing-8); }
      .section-body { margin-top: var(--spacing-8); }
      .grid-3 { display: grid; gap: var(--spacing-6); grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); padding: 0; list-style: none; }
      .logos { display: flex; flex-wrap: wrap; gap: var(--spacing-8); color: var(--color-text-muted); }
      .plan-featured { border-color: var(--color-accent); }
      .faq details { padding-block: var(--spacing-4); border-bottom: 1px solid var(--color-border); }
      .faq summary { cursor: pointer; font-weight: var(--text-title--font-weight); }
      .faq details p { margin-top: var(--spacing-3); }
      .footer { padding-block: var(--spacing-12); color: var(--color-text-muted); }
      @media (max-width: 40rem) { .hide-sm { display: none; } }
    </style>
  </head>
  <body>
    <header class="wrap nav">
      <a href="/" class="brand t-title">Product name</a>
      <nav aria-label="Main">
        <ul class="nav-links">
          <li class="hide-sm"><a href="#how">How it works</a></li>
          <li class="hide-sm"><a href="#pricing">Pricing</a></li>
          <li><a class="btn btn-primary" href="#start">Get started</a></li>
          <li>
            <button class="btn btn-secondary" type="button" data-theme-toggle aria-pressed="false">
              <span class="visually-hidden">Dark theme</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            </button>
          </li>
        </ul>
      </nav>
    </header>

    <main>
      <!-- HERO: one promise, one primary action. Headline up to 8 words, subline up to 25 words. -->
      <section class="wrap hero" aria-labelledby="hero-title">
        <p class="t-label t-muted">Say who it is for</p>
        <h1 id="hero-title" class="t-display">State the outcome, not the feature</h1>
        <p class="lede t-body t-muted">
          One or two sentences on what the product does and why it is different. Concrete nouns, no hype.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="#start">Primary action</a>
          <a class="btn btn-secondary" href="#how">See how it works</a>
        </div>
      </section>

      <!-- SOCIAL PROOF: real customer names, numbers or one short quote. -->
      <section class="wrap" aria-label="Trusted by">
        <div class="logos t-label">
          <span>Customer one</span><span>Customer two</span><span>Customer three</span><span>Customer four</span>
        </div>
      </section>

      <!-- FEATURES: three blocks maximum. Title up to 5 words, body up to 30 words each. -->
      <section class="wrap section" aria-labelledby="features-title">
        <h2 id="features-title" class="t-headline">Why people choose it</h2>
        <div class="grid-3 section-body">
          <article class="card stack">
            <h3 class="t-title">First benefit</h3>
            <p class="t-body-small t-muted">What the user gets, in plain words, with a number if you have one.</p>
          </article>
          <article class="card stack">
            <h3 class="t-title">Second benefit</h3>
            <p class="t-body-small t-muted">What the user gets, in plain words, with a number if you have one.</p>
          </article>
          <article class="card stack">
            <h3 class="t-title">Third benefit</h3>
            <p class="t-body-small t-muted">What the user gets, in plain words, with a number if you have one.</p>
          </article>
        </div>
      </section>

      <!-- HOW IT WORKS: three numbered steps. -->
      <section id="how" class="wrap section" aria-labelledby="how-title">
        <h2 id="how-title" class="t-headline">How it works</h2>
        <ol class="grid-3 section-body">
          <li class="stack"><span class="t-label t-muted num">01</span><h3 class="t-title">First step</h3><p class="t-body-small t-muted">One sentence.</p></li>
          <li class="stack"><span class="t-label t-muted num">02</span><h3 class="t-title">Second step</h3><p class="t-body-small t-muted">One sentence.</p></li>
          <li class="stack"><span class="t-label t-muted num">03</span><h3 class="t-title">Third step</h3><p class="t-body-small t-muted">One sentence.</p></li>
        </ol>
      </section>

      <!-- PRICING: two or three plans. Highlight one with a border, never a gradient. -->
      <section id="pricing" class="wrap section" aria-labelledby="pricing-title">
        <h2 id="pricing-title" class="t-headline">Pricing</h2>
        <div class="grid-3 section-body">
          <article class="card stack">
            <h3 class="t-title">Starter</h3>
            <p class="t-headline num">$0</p>
            <p class="t-body-small t-muted">Who this plan is for.</p>
            <a class="btn btn-secondary" href="#start">Choose Starter</a>
          </article>
          <article class="card stack plan-featured">
            <h3 class="t-title">Pro</h3>
            <p class="t-headline num">$12 <span class="t-body t-muted">per month</span></p>
            <p class="t-body-small t-muted">Who this plan is for.</p>
            <a class="btn btn-primary" href="#start">Choose Pro</a>
          </article>
        </div>
      </section>

      <!-- FAQ: the questions people actually ask before buying. -->
      <section class="wrap section faq" aria-labelledby="faq-title">
        <h2 id="faq-title" class="t-headline">Questions</h2>
        <div class="section-body">
          <details><summary>A question customers ask before buying?</summary><p class="t-body t-muted">A direct, specific answer.</p></details>
          <details><summary>Another real question?</summary><p class="t-body t-muted">A direct, specific answer.</p></details>
        </div>
      </section>

      <!-- FINAL CTA: repeat the single primary action. -->
      <section id="start" class="wrap section" aria-labelledby="cta-title">
        <h2 id="cta-title" class="t-headline">Restate the outcome in one line</h2>
        <div class="actions"><a class="btn btn-primary" href="#">Primary action</a></div>
      </section>
    </main>

    <footer class="wrap footer t-body-small">
      <p>&copy; Company name. Address or legal line.</p>
    </footer>
    <script src="js/theme.js" defer></script>
  </body>
</html>
"
`;

exports[`tailwind adapter > matches snapshots > js/theme.js 1`] = `
"// Generated by premium-ui-mcp from the "fintech-trust" design direction (v1).
// Use these tokens everywhere; do not hardcode colors, sizes, radii or fonts in screens.
// Light/dark theme toggle. The theme lives in <html data-theme="light|dark"> and the
// user's explicit choice is stored in localStorage under "theme". Without a stored choice
// the system setting is followed, including live changes.
//
// Put the inline snippet from index.html in <head> BEFORE any stylesheet so the right
// theme is applied before first paint (no flash). This file adds the toggle behaviour.
(function () {
  var KEY = 'theme';
  var root = document.documentElement;
  var media = window.matchMedia('(prefers-color-scheme: dark)');

  function stored() {
    try {
      var t = localStorage.getItem(KEY);
      return t === 'light' || t === 'dark' ? t : null;
    } catch (e) {
      return null;
    }
  }

  function apply(theme) {
    root.setAttribute('data-theme', theme);
    var buttons = document.querySelectorAll('[data-theme-toggle]');
    for (var i = 0; i < buttons.length; i++) {
      buttons[i].setAttribute('aria-pressed', String(theme === 'dark'));
    }
  }

  function current() {
    return stored() || (media.matches ? 'dark' : 'light');
  }

  function set(theme) {
    try {
      localStorage.setItem(KEY, theme);
    } catch (e) {}
    apply(theme);
  }

  media.addEventListener('change', function () {
    if (!stored()) apply(current());
  });

  document.addEventListener('click', function (event) {
    var target = event.target instanceof Element ? event.target.closest('[data-theme-toggle]') : null;
    if (target) set(current() === 'dark' ? 'light' : 'dark');
  });

  apply(current());
  window.theme = { get: current, set: set };
})();
"
`;
