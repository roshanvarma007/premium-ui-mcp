package com.example.app.ui.theme

import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.material3.Shapes
import androidx.compose.runtime.Immutable
import androidx.compose.ui.graphics.Shape
import androidx.compose.ui.unit.dp

/**
 * Buttons and inputs md, cards md, sheets and dialogs lg, chips and avatars full. Never mix more than 3 radii on one screen.
 */
@Immutable
data class AppShapes(
    val sm: Shape,
    val md: Shape,
    val lg: Shape,
    val full: Shape,
)

val AppShapeTokens = AppShapes(
    sm = RoundedCornerShape(6.dp),
    md = RoundedCornerShape(12.dp),
    lg = RoundedCornerShape(16.dp),
    full = RoundedCornerShape(percent = 50),
)

val AppMaterialShapes = Shapes(
    extraSmall = RoundedCornerShape(6.dp),
    small = RoundedCornerShape(6.dp),
    medium = RoundedCornerShape(12.dp),
    large = RoundedCornerShape(16.dp),
    extraLarge = RoundedCornerShape(16.dp),
)
"
`;

