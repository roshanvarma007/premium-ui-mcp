"// Generated by premium-ui-mcp from the "fintech-trust" design direction (v1).
// Use these tokens everywhere; do not hardcode colors, sizes, radii or fonts in screens.
package com.example.app.ui.theme

import androidx.compose.ui.unit.dp

/**
 * Spacing scale on a 4dp grid. Names are multiples of the base unit:
 * s4 = 16dp. Use only these values for padding, gaps and offsets.
 */
object Spacing {
    val s0 = 0.dp
    val s1 = 4.dp
    val s2 = 8.dp
    val s3 = 12.dp
    val s4 = 16.dp
    val s6 = 24.dp
    val s8 = 32.dp
    val s12 = 48.dp
    val s16 = 64.dp
    val s24 = 96.dp

    /** Minimum touch target (Material accessibility guidance). */
    val minTouchTarget = 48.dp
}
"
