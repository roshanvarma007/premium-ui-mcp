exports[`compose adapter > matches snapshots (both modes, bundled) > app/src/main/java/com/example/app/ui/theme/Theme.kt 1`] = `
"// Generated by premium-ui-mcp from the "fintech-trust" design direction (v1).
// Use these tokens everywhere; do not hardcode colors, sizes, radii or fonts in screens.
package com.example.app.ui.theme

import androidx.compose.animation.core.CubicBezierEasing
import androidx.compose.foundation.isSystemInDarkTheme
import androidx.compose.material3.ColorScheme
import androidx.compose.material3.MaterialTheme
import androidx.compose.material3.darkColorScheme
import androidx.compose.material3.lightColorScheme
import androidx.compose.runtime.Composable
import androidx.compose.runtime.CompositionLocalProvider
import androidx.compose.runtime.ReadOnlyComposable
import androidx.compose.runtime.staticCompositionLocalOf
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.unit.dp

/** Elevation levels (borders-first). Prefer borders; elevate only overlays and interactive layers. */
object AppElevation {
    val none = 0.dp
    val raised = 1.dp
    val overlay = 6.dp
}

/**
 * Motion tokens.
 * - Animate opacity and transform only
 * - No bounce or overshoot on financial data
 * - Numbers update instantly; never count up balances
 * - Respect reduced-motion: replace movement with a short fade
 */
object AppMotion {
    const val FAST_MS = 120
    const val BASE_MS = 200
    const val SLOW_MS = 320
    val Easing = CubicBezierEasing(0.2f, 0f, 0f, 1f)
}

private val LocalAppColors = staticCompositionLocalOf { LightAppColors }
private val LocalAppTypography = staticCompositionLocalOf { AppType }
private val LocalAppShapes = staticCompositionLocalOf { AppShapeTokens }

/**
 * Maps the direction onto every Material 3 color role, so stock components never fall
 * back to the baseline purple scheme.
 */
private fun AppColors.toColorScheme(inverseAccent: Color): ColorScheme {
    val base = if (isDark) darkColorScheme() else lightColorScheme()
    return base.copy(
        primary = accent,
        onPrimary = onAccent,
        primaryContainer = surfaceAlt,
        onPrimaryContainer = text,
        inversePrimary = inverseAccent,
        secondary = accent,
        onSecondary = onAccent,
        secondaryContainer = surfaceAlt,
        onSecondaryContainer = text,
        tertiary = accent,
        onTertiary = onAccent,
        tertiaryContainer = surfaceAlt,
        onTertiaryContainer = text,
        background = bg,
        onBackground = text,
        surface = surface,
        onSurface = text,
        surfaceVariant = surfaceAlt,
        onSurfaceVariant = textMuted,
        surfaceTint = surface,
        inverseSurface = text,
        inverseOnSurface = bg,
        error = error,
        onError = onError,
        errorContainer = surfaceAlt,
        onErrorContainer = text,
        outline = borderStrong,
        outlineVariant = border,
        scrim = Color.Black,
        surfaceBright = surface,
        surfaceDim = surfaceAlt,
        surfaceContainerLowest = surface,
        surfaceContainerLow = surface,
        surfaceContainer = surface,
        surfaceContainerHigh = surface,
        surfaceContainerHighest = surfaceAlt,
        primaryFixed = surfaceAlt,
        primaryFixedDim = surfaceAlt,
        onPrimaryFixed = text,
        onPrimaryFixedVariant = textMuted,
        secondaryFixed = surfaceAlt,
        secondaryFixedDim = surfaceAlt,
        onSecondaryFixed = text,
        onSecondaryFixedVariant = textMuted,
        tertiaryFixed = surfaceAlt,
        tertiaryFixedDim = surfaceAlt,
        onTertiaryFixed = text,
        onTertiaryFixedVariant = textMuted,
    )
}

@Composable
fun AppTheme(
    darkTheme: Boolean = isSystemInDarkTheme(),
    content: @Composable () -> Unit,
) {
    val colors = if (darkTheme) DarkAppColors else LightAppColors
    CompositionLocalProvider(
        LocalAppColors provides colors,
        LocalAppTypography provides AppType,
        LocalAppShapes provides AppShapeTokens,
    ) {
        MaterialTheme(
            colorScheme = colors.toColorScheme(inverseAccent = if (colors.isDark) Color(0xFF0F6B4F) else Color(0xFF5CC49B)),
            typography = AppMaterialTypography,
            shapes = AppMaterialShapes,
            content = content,
        )
    }
}

/** Accessors for the direction tokens: AppTheme.colors.accent, AppTheme.type.body, ... */
object AppTheme {
    val colors: AppColors
        @Composable @ReadOnlyComposable
        get() = LocalAppColors.current

    val type: AppTypography
        @Composable @ReadOnlyComposable
        get() = LocalAppTypography.current

    val shapes: AppShapes
        @Composable @ReadOnlyComposable
        get() = LocalAppShapes.current

    val spacing: Spacing get() = Spacing
}
"
`;

