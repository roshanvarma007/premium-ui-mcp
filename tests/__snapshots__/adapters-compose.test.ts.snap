"// Generated by premium-ui-mcp from the "fintech-trust" design direction (v1).
// Use these tokens everywhere; do not hardcode colors, sizes, radii or fonts in screens.
package com.example.app.ui.theme

import androidx.compose.material3.Typography
import androidx.compose.runtime.Immutable
import androidx.compose.ui.text.TextStyle
import androidx.compose.ui.text.font.Font
import androidx.compose.ui.text.font.FontFamily
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.em
import androidx.compose.ui.unit.sp
import com.example.app.R

/** Fraunces (OFL-1.1). Fallback: Georgia, Times New Roman, serif. */
val FrauncesFontFamily = FontFamily(
    Font(R.font.fraunces_semibold, FontWeight.W600),
)

/** Manrope (OFL-1.1). Fallback: system-ui, -apple-system, Segoe UI, Roboto, sans-serif. */
val ManropeFontFamily = FontFamily(
    Font(R.font.manrope_regular, FontWeight.W400),
    Font(R.font.manrope_medium, FontWeight.W500),
    Font(R.font.manrope_semibold, FontWeight.W600),
)

/** JetBrains Mono (OFL-1.1). Fallback: ui-monospace, SFMono-Regular, Consolas, monospace. */
val JetBrainsMonoFontFamily = FontFamily(
    Font(R.font.jetbrains_mono_regular, FontWeight.W400),
)

/** The seven type roles of the direction. Do not add sizes outside this scale. */
@Immutable
data class AppTypography(
    val display: TextStyle,
    val headline: TextStyle,
    val title: TextStyle,
    val body: TextStyle,
    val bodySmall: TextStyle,
    val label: TextStyle,
    val caption: TextStyle,
)

val AppType = AppTypography(
    display = TextStyle(
        fontFamily = FrauncesFontFamily,
        fontWeight = FontWeight.W600,
        fontSize = 40.sp,
        lineHeight = 48.sp,
        letterSpacing = (-0.02).em,
        fontFeatureSettings = "tnum",
    ),
    headline = TextStyle(
        fontFamily = FrauncesFontFamily,
        fontWeight = FontWeight.W600,
        fontSize = 28.sp,
        lineHeight = 36.sp,
        letterSpacing = (-0.01).em,
        fontFeatureSettings = "tnum",
    ),
    title = TextStyle(
        fontFamily = ManropeFontFamily,
        fontWeight = FontWeight.W600,
        fontSize = 18.sp,
        lineHeight = 24.sp,
        letterSpacing = 0.em,
        fontFeatureSettings = "tnum",
    ),
    body = TextStyle(
        fontFamily = ManropeFontFamily,
        fontWeight = FontWeight.W400,
        fontSize = 16.sp,
        lineHeight = 24.sp,
        letterSpacing = 0.em,
        fontFeatureSettings = "tnum",
    ),
    bodySmall = TextStyle(
        fontFamily = ManropeFontFamily,
        fontWeight = FontWeight.W400,
        fontSize = 14.sp,
        lineHeight = 20.sp,
        letterSpacing = 0.em,
        fontFeatureSettings = "tnum",
    ),
    label = TextStyle(
        fontFamily = ManropeFontFamily,
        fontWeight = FontWeight.W500,
        fontSize = 12.sp,
        lineHeight = 16.sp,
        letterSpacing = 0.02.em,
        fontFeatureSettings = "tnum",
    ),
    caption = TextStyle(
        fontFamily = ManropeFontFamily,
        fontWeight = FontWeight.W400,
        fontSize = 12.sp,
        lineHeight = 16.sp,
        letterSpacing = 0.01.em,
        fontFeatureSettings = "tnum",
    ),
)

/** Material 3 roles mapped onto the same seven styles, so stock components match. */
val AppMaterialTypography = Typography(
    displayLarge = AppType.display,
    displayMedium = AppType.display,
    displaySmall = AppType.display,
    headlineLarge = AppType.headline,
    headlineMedium = AppType.headline,
    headlineSmall = AppType.headline,
    titleLarge = AppType.title,
    titleMedium = AppType.title,
    titleSmall = AppType.bodySmall.copy(fontWeight = FontWeight.W600),
    bodyLarge = AppType.body,
    bodyMedium = AppType.bodySmall,
    bodySmall = AppType.caption,
    labelLarge = AppType.bodySmall.copy(fontWeight = FontWeight.W600),
    labelMedium = AppType.label,
    labelSmall = AppType.label,
)
"
`;
