exports[`android-xml adapter > is deterministic and matches snapshots > app/src/main/res/values/dimens.xml 1`] = `
"<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by premium-ui-mcp from the "fintech-trust" design direction (v1).
     Use these tokens everywhere; do not hardcode colors, sizes, radii or fonts in screens. -->
<resources>
    <!-- Spacing on a 4dp grid. ds_space_4 = 16dp. -->
    <dimen name="ds_space_0">0dp</dimen>
    <dimen name="ds_space_1">4dp</dimen>
    <dimen name="ds_space_2">8dp</dimen>
    <dimen name="ds_space_3">12dp</dimen>
    <dimen name="ds_space_4">16dp</dimen>
    <dimen name="ds_space_6">24dp</dimen>
    <dimen name="ds_space_8">32dp</dimen>
    <dimen name="ds_space_12">48dp</dimen>
    <dimen name="ds_space_16">64dp</dimen>
    <dimen name="ds_space_24">96dp</dimen>

    <!-- Radii. Buttons and inputs md, cards md, sheets and dialogs lg, chips and avatars full. Never mix more than 3 radii on one screen. -->
    <dimen name="ds_radius_sm">6dp</dimen>
    <dimen name="ds_radius_md">12dp</dimen>
    <dimen name="ds_radius_lg">16dp</dimen>

    <!-- Elevation (borders-first) -->
    <dimen name="ds_elevation_none">0dp</dimen>
    <dimen name="ds_elevation_raised">1dp</dimen>
    <dimen name="ds_elevation_overlay">6dp</dimen>

    <dimen name="ds_border">1dp</dimen>
    <dimen name="ds_touch_target">48dp</dimen>
</resources>
"
`;

