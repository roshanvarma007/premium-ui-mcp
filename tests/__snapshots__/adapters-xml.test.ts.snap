"<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by premium-ui-mcp from the "fintech-trust" design direction (v1).
     Use these tokens everywhere; do not hardcode colors, sizes, radii or fonts in screens. -->
<resources>
    <!-- App theme: every Material 3 color role, type role and shape is mapped to the
         direction, so no component falls back to the baseline purple scheme. -->
    <style name="Theme.App" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colors -->
        <item name="colorPrimary">@color/ds_accent</item>
        <item name="colorOnPrimary">@color/ds_on_accent</item>
        <item name="colorPrimaryContainer">@color/ds_surface_alt</item>
        <item name="colorOnPrimaryContainer">@color/ds_text</item>
        <item name="colorPrimaryFixed">@color/ds_surface_alt</item>
        <item name="colorPrimaryFixedDim">@color/ds_surface_alt</item>
        <item name="colorOnPrimaryFixed">@color/ds_text</item>
        <item name="colorOnPrimaryFixedVariant">@color/ds_text_muted</item>
        <item name="colorSecondary">@color/ds_accent</item>
        <item name="colorOnSecondary">@color/ds_on_accent</item>
        <item name="colorSecondaryContainer">@color/ds_surface_alt</item>
        <item name="colorOnSecondaryContainer">@color/ds_text</item>
        <item name="colorSecondaryFixed">@color/ds_surface_alt</item>
        <item name="colorSecondaryFixedDim">@color/ds_surface_alt</item>
        <item name="colorOnSecondaryFixed">@color/ds_text</item>
        <item name="colorOnSecondaryFixedVariant">@color/ds_text_muted</item>
        <item name="colorTertiary">@color/ds_accent</item>
        <item name="colorOnTertiary">@color/ds_on_accent</item>
        <item name="colorTertiaryContainer">@color/ds_surface_alt</item>
        <item name="colorOnTertiaryContainer">@color/ds_text</item>
        <item name="colorTertiaryFixed">@color/ds_surface_alt</item>
        <item name="colorTertiaryFixedDim">@color/ds_surface_alt</item>
        <item name="colorOnTertiaryFixed">@color/ds_text</item>
        <item name="colorOnTertiaryFixedVariant">@color/ds_text_muted</item>
        <item name="colorPrimaryInverse">@color/ds_accent_inverse</item>
        <item name="android:colorBackground">@color/ds_bg</item>
        <item name="colorOnBackground">@color/ds_text</item>
        <item name="colorSurface">@color/ds_surface</item>
        <item name="colorOnSurface">@color/ds_text</item>
        <item name="colorSurfaceVariant">@color/ds_surface_alt</item>
        <item name="colorOnSurfaceVariant">@color/ds_text_muted</item>
        <item name="colorSurfaceInverse">@color/ds_text</item>
        <item name="colorOnSurfaceInverse">@color/ds_bg</item>
        <item name="colorSurfaceBright">@color/ds_surface</item>
        <item name="colorSurfaceDim">@color/ds_surface_alt</item>
        <item name="colorSurfaceContainerLowest">@color/ds_surface</item>
        <item name="colorSurfaceContainerLow">@color/ds_surface</item>
        <item name="colorSurfaceContainer">@color/ds_surface</item>
        <item name="colorSurfaceContainerHigh">@color/ds_surface</item>
        <item name="colorSurfaceContainerHighest">@color/ds_surface_alt</item>
        <item name="colorOutline">@color/ds_border_strong</item>
        <item name="colorOutlineVariant">@color/ds_border</item>
        <item name="colorError">@color/ds_error</item>
        <item name="colorOnError">@color/ds_on_error</item>
        <item name="colorErrorContainer">@color/ds_surface_alt</item>
        <item name="colorOnErrorContainer">@color/ds_text</item>

        <!-- Type -->
        <item name="android:fontFamily">@font/manrope_regular</item>
        <item name="fontFamily">@font/manrope_regular</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.App.Display</item>
        <item name="textAppearanceDisplayLargeEmphasized">@style/TextAppearance.App.Display</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.App.Display</item>
        <item name="textAppearanceDisplayMediumEmphasized">@style/TextAppearance.App.Display</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.App.Display</item>
        <item name="textAppearanceDisplaySmallEmphasized">@style/TextAppearance.App.Display</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.App.Headline</item>
        <item name="textAppearanceHeadlineLargeEmphasized">@style/TextAppearance.App.Headline</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.Headline</item>
        <item name="textAppearanceHeadlineMediumEmphasized">@style/TextAppearance.App.Headline</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.Headline</item>
        <item name="textAppearanceHeadlineSmallEmphasized">@style/TextAppearance.App.Headline</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.Title</item>
        <item name="textAppearanceTitleLargeEmphasized">@style/TextAppearance.App.Title</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.Title</item>
        <item name="textAppearanceTitleMediumEmphasized">@style/TextAppearance.App.Title</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.App.Button</item>
        <item name="textAppearanceTitleSmallEmphasized">@style/TextAppearance.App.Button</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.Body</item>
        <item name="textAppearanceBodyLargeEmphasized">@style/TextAppearance.App.Body</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.BodySmall</item>
        <item name="textAppearanceBodyMediumEmphasized">@style/TextAppearance.App.BodySmall</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.Caption</item>
        <item name="textAppearanceBodySmallEmphasized">@style/TextAppearance.App.Caption</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.Button</item>
        <item name="textAppearanceLabelLargeEmphasized">@style/TextAppearance.App.Button</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.App.Label</item>
        <item name="textAppearanceLabelMediumEmphasized">@style/TextAppearance.App.Label</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.App.Label</item>
        <item name="textAppearanceLabelSmallEmphasized">@style/TextAppearance.App.Label</item>

        <!-- Shapes -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.App.Small</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.App.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.App.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.App.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.App.Large</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.Medium</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.Large</item>

        <!-- Components -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.Outlined</item>
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>
        <item name="textInputStyle">@style/Widget.App.TextInput</item>

        <!-- Window: background matches bg so there is no flash on launch -->
        <item name="android:windowBackground">@color/ds_bg</item>
        <item name="android:windowLightStatusBar">@bool/ds_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/ds_light_system_bars</item>
    </style>

    <!-- Primary button: solid accent, md radius, 48dp minimum height. One per screen. -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/ds_accent</item>
        <item name="android:textColor">@color/ds_on_accent</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Medium</item>
        <item name="android:minHeight">@dimen/ds_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Secondary button: 1dp border_strong outline, text color label. -->
    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/ds_border_strong</item>
        <item name="android:textColor">@color/ds_text</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Medium</item>
        <item name="android:minHeight">@dimen/ds_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Card: surface fill, hairline border, no shadow unless interactive. -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/ds_surface</item>
        <item name="strokeColor">@color/ds_border</item>
        <item name="strokeWidth">@dimen/ds_border</item>
        <item name="cardElevation">@dimen/ds_elevation_none</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Medium</item>
    </style>

    <!-- Input: outlined, visible label always (never placeholder-only). -->
    <style name="Widget.App.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/ds_border_strong</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Medium</item>
        <item name="hintTextAppearance">@style/TextAppearance.App.Label</item>
    </style>
</resources>
"
`;

exports[`android-xml adapter > is deterministic and matches snapshots > app/src/main/res/values/type.xml 1`] = `
"<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by premium-ui-mcp from the "fintech-trust" design direction (v1).
     Use these tokens everywhere; do not hardcode colors, sizes, radii or fonts in screens. -->
<resources>
    <!-- The seven type roles. Use only these; never set textSize in layouts. -->
    <!-- display: 40sp / 48sp, weight 600 -->
    <style name="TextAppearance.App.Display" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/fraunces_semibold</item>
        <item name="fontFamily">@font/fraunces_semibold</item>
        <item name="android:textSize">40sp</item>
        <item name="lineHeight">48sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- headline: 28sp / 36sp, weight 600 -->
    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/fraunces_semibold</item>
        <item name="fontFamily">@font/fraunces_semibold</item>
        <item name="android:textSize">28sp</item>
        <item name="lineHeight">36sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- title: 18sp / 24sp, weight 600 -->
    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="fontFamily">@font/manrope_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="lineHeight">24sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- body: 16sp / 24sp, weight 400 -->
    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/manrope_regular</item>
        <item name="fontFamily">@font/manrope_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">24sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- body_small: 14sp / 20sp, weight 400 -->
    <style name="TextAppearance.App.BodySmall" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/manrope_regular</item>
        <item name="fontFamily">@font/manrope_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- label: 12sp / 16sp, weight 500 -->
    <style name="TextAppearance.App.Label" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/manrope_medium</item>
        <item name="fontFamily">@font/manrope_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- caption: 12sp / 16sp, weight 400 -->
    <style name="TextAppearance.App.Caption" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/manrope_regular</item>
        <item name="fontFamily">@font/manrope_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- Buttons: body-small size at the title weight -->
    <style name="TextAppearance.App.Button" parent="TextAppearance.App.BodySmall">
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="fontFamily">@font/manrope_semibold</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
"
`;

