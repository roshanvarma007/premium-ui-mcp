{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "surface": {
      "type": "string",
      "enum": [
        "landing",
        "app",
        "game",
        "dashboard",
        "ecommerce"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "principles": {
      "minItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "structure_note": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "minItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "guidance": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "copy": {
            "type": "object",
            "properties": {
              "headline_max_words": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "body_max_words": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "platform_notes": {
            "type": "object",
            "properties": {
              "web": {
                "type": "string",
                "minLength": 1
              },
              "android": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "required",
          "purpose",
          "guidance"
        ],
        "additionalProperties": false
      }
    },
    "states": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "guidance": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "guidance"
        ],
        "additionalProperties": false
      },
      "description": "Non-happy-path states that are part of the design"
    },
    "accessibility": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "avoid": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "id",
    "surface",
    "name",
    "summary",
    "principles",
    "structure_note",
    "sections",
    "states",
    "accessibility",
    "avoid"
  ],
  "additionalProperties": false
}
