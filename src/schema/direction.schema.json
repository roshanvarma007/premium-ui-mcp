          },
          "required": [
            "display",
            "headline",
            "title",
            "body",
            "body_small",
            "label",
            "caption"
          ],
          "additionalProperties": false
        },
        "web_responsive": {
          "description": "Fluid clamp() range (px) for web display sizes",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "display",
              "headline",
              "title",
              "body",
              "body_small",
              "label",
              "caption"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "min": {
                "type": "number",
                "minimum": 10
              },
              "max": {
                "type": "number",
                "maximum": 160
              }
            },
            "required": [
              "min",
              "max"
            ],
            "additionalProperties": false
          }
        },
        "numerals": {
          "description": "Default numeral style for data and money values",
          "type": "string",
          "enum": [
            "proportional",
            "tabular"
          ]
        }
      },
      "required": [
        "display_family",
        "body_family",
        "scale"
      ],
      "additionalProperties": false
    },
    "spacing": {
      "type": "object",
      "properties": {
        "base": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        },
        "scale": {
          "minItems": 6,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "base",
        "scale"
      ],
      "additionalProperties": false
    },
    "radius": {
      "type": "object",
      "properties": {
        "sm": {
          "type": "number",
          "minimum": 0
        },
        "md": {
          "type": "number",
          "minimum": 0
        },
        "lg": {
          "type": "number",
          "minimum": 0
        },
        "full": {
          "type": "number",
          "minimum": 0
        },
        "usage": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sm",
        "md",
        "lg",
        "full",
        "usage"
      ],
      "additionalProperties": false
    },
    "elevation": {
      "type": "object",
      "properties": {
        "style": {
          "type": "string",
          "enum": [
            "borders-first",
            "soft-shadows",
            "flat",
            "outlined-bold"
          ]
        },
        "levels": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "shadow": {
                "description": "CSS box-shadow value (light theme)",
                "type": "string"
              },
              "shadow_dark": {
                "description": "CSS box-shadow value (dark theme)",
                "type": "string"
              },
              "elevation_dp": {
                "type": "number",
                "minimum": 0,
                "maximum": 24,
                "description": "Android elevation"
              }
            },
            "required": [
              "name",
              "elevation_dp"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "style",
        "levels"
      ],
      "additionalProperties": false
    },
    "motion": {
      "type": "object",
      "properties": {
        "duration_ms": {
          "type": "object",
          "properties": {
            "fast": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "base": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "slow": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "fast",
            "base",
            "slow"
          ],
          "additionalProperties": false
        },
        "easing": {
          "type": "string",
          "pattern": "^cubic-bezier\\(\\s*-?[\\d.]+\\s*,\\s*-?[\\d.]+\\s*,\\s*-?[\\d.]+\\s*,\\s*-?[\\d.]+\\s*\\)$"
        },
        "rules": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "duration_ms",
        "easing",
        "rules"
      ],
      "additionalProperties": false
    },
    "iconography": {
      "type": "object",
      "properties": {
        "style": {
          "type": "string",
          "minLength": 1
        },
        "recommended_sets": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "never": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "style",
        "recommended_sets",
        "never"
      ],
      "additionalProperties": false
    },
    "components": {
      "type": "object",
      "properties": {
        "button": {
          "type": "string",
          "minLength": 1
        },
        "card": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "list": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "button",
        "card",
        "input",
        "list"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "signature_details": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "avoid": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "permits": {
      "description": "AI-look patterns this direction deliberately allows. All default to false.",
      "type": "object",
      "properties": {
        "gradients": {
          "type": "boolean"
