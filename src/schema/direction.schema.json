                },
                "family": {
                  "description": "Defaults: display/headline use display, others use body",
                  "type": "string",
                  "enum": [
                    "display",
                    "body",
                    "mono"
                  ]
                }
              },
              "required": [
                "size",
                "weight",
                "line_height",
                "letter_spacing"
              ],
              "additionalProperties": false
            },
            "body_small": {
              "type": "object",
              "properties": {
                "size": {
                  "type": "number",
                  "minimum": 10,
                  "maximum": 120,
                  "description": "px on web (base 16), sp on Android"
                },
                "weight": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 900
                },
                "line_height": {
                  "type": "number",
                  "minimum": 10,
                  "maximum": 160,
                  "description": "Absolute line height, same unit as size"
                },
                "letter_spacing": {
                  "type": "number",
                  "minimum": -0.1,
                  "maximum": 0.2,
                  "description": "em"
                },
                "family": {
                  "description": "Defaults: display/headline use display, others use body",
                  "type": "string",
                  "enum": [
                    "display",
                    "body",
                    "mono"
                  ]
                }
              },
              "required": [
                "size",
                "weight",
                "line_height",
                "letter_spacing"
              ],
              "additionalProperties": false
            },
            "label": {
              "type": "object",
              "properties": {
                "size": {
                  "type": "number",
                  "minimum": 10,
                  "maximum": 120,
                  "description": "px on web (base 16), sp on Android"
                },
                "weight": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 900
                },
                "line_height": {
                  "type": "number",
                  "minimum": 10,
                  "maximum": 160,
                  "description": "Absolute line height, same unit as size"
                },
                "letter_spacing": {
                  "type": "number",
                  "minimum": -0.1,
                  "maximum": 0.2,
                  "description": "em"
                },
                "family": {
                  "description": "Defaults: display/headline use display, others use body",
                  "type": "string",
                  "enum": [
                    "display",
                    "body",
                    "mono"
                  ]
                }
              },
              "required": [
                "size",
                "weight",
                "line_height",
                "letter_spacing"
              ],
              "additionalProperties": false
            },
            "caption": {
              "type": "object",
              "properties": {
                "size": {
                  "type": "number",
                  "minimum": 10,
                  "maximum": 120,
                  "description": "px on web (base 16), sp on Android"
                },
                "weight": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 900
                },
                "line_height": {
                  "type": "number",
                  "minimum": 10,
                  "maximum": 160,
                  "description": "Absolute line height, same unit as size"
                },
                "letter_spacing": {
                  "type": "number",
                  "minimum": -0.1,
                  "maximum": 0.2,
                  "description": "em"
                },
                "family": {
                  "description": "Defaults: display/headline use display, others use body",
                  "type": "string",
                  "enum": [
                    "display",
