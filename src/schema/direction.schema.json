{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 240
    },
    "best_for": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "avoid_for": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mood": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "color": {
      "type": "object",
      "properties": {
        "light": {
          "type": "object",
          "properties": {
            "bg": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "Page / screen background"
            },
            "surface": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "Cards, sheets, primary containers"
            },
            "surface_alt": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "Secondary containers, filled inputs, table stripes"
            },
            "text": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "Primary text. Must reach 4.5:1 on bg, surface and surface_alt"
            },
            "text_muted": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "Secondary text. Must reach 4.5:1 on bg, surface and surface_alt"
            },
            "border": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "Decorative hairlines and dividers (no contrast requirement)"
            },
            "border_strong": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "Boundaries that identify controls, such as input outlines. Must reach 3:1 on bg and surface"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "The single accent. 3:1 on bg and surface; 4.5:1 when no separate link color is set"
            },
            "on_accent": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "Text and icons on accent fills. Must reach 4.5:1 on accent"
            },
            "link": {
              "description": "Optional link text color, when accent is not dark/light enough for body links",
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$"
            },
            "success": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "Meaning only. Must reach 4.5:1 on bg and surface"
            },
            "warning": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "Meaning only. Must reach 4.5:1 on bg and surface"
            },
            "error": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "Meaning only. Must reach 4.5:1 on bg and surface"
            }
          },
          "required": [
            "bg",
            "surface",
            "surface_alt",
            "text",
            "text_muted",
            "border",
            "border_strong",
            "accent",
            "on_accent",
            "success",
            "warning",
            "error"
          ],
          "additionalProperties": false
        },
        "dark": {
          "type": "object",
          "properties": {
            "bg": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "Page / screen background"
            },
            "surface": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "Cards, sheets, primary containers"
            },
            "surface_alt": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "Secondary containers, filled inputs, table stripes"
            },
            "text": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "Primary text. Must reach 4.5:1 on bg, surface and surface_alt"
            },
            "text_muted": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "Secondary text. Must reach 4.5:1 on bg, surface and surface_alt"
            },
            "border": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "Decorative hairlines and dividers (no contrast requirement)"
            },
            "border_strong": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "Boundaries that identify controls, such as input outlines. Must reach 3:1 on bg and surface"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "The single accent. 3:1 on bg and surface; 4.5:1 when no separate link color is set"
            },
            "on_accent": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "Text and icons on accent fills. Must reach 4.5:1 on accent"
            },
            "link": {
              "description": "Optional link text color, when accent is not dark/light enough for body links",
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$"
            },
            "success": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "Meaning only. Must reach 4.5:1 on bg and surface"
            },
            "warning": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "Meaning only. Must reach 4.5:1 on bg and surface"
            },
            "error": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "Meaning only. Must reach 4.5:1 on bg and surface"
            }
          },
          "required": [
            "bg",
            "surface",
            "surface_alt",
            "text",
            "text_muted",
            "border",
            "border_strong",
            "accent",
            "on_accent",
            "success",
            "warning",
            "error"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "light",
        "dark"
      ],
      "additionalProperties": false
    },
    "typography": {
      "type": "object",
      "properties": {
        "display_family": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "enum": [
                "OFL-1.1",
                "Apache-2.0",
                "UFL-1.0",
                "MIT"
              ]
            },
            "source": {
              "type": "string",
              "enum": [
                "google-fonts",
                "fontsource",
                "bundled"
              ]
            },
            "weights": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 100,
                "maximum": 900
              },
              "description": "Weights the direction uses"
            },
            "fallback": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "license",
            "source",
            "weights",
            "fallback"
          ],
          "additionalProperties": false
        },
        "body_family": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "enum": [
                "OFL-1.1",
                "Apache-2.0",
                "UFL-1.0",
                "MIT"
              ]
            },
            "source": {
              "type": "string",
              "enum": [
                "google-fonts",
                "fontsource",
                "bundled"
              ]
            },
            "weights": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 100,
                "maximum": 900
              },
              "description": "Weights the direction uses"
            },
            "fallback": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "license",
            "source",
            "weights",
            "fallback"
          ],
          "additionalProperties": false
        },
        "mono_family": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "enum": [
                "OFL-1.1",
                "Apache-2.0",
                "UFL-1.0",
                "MIT"
              ]
            },
            "source": {
              "type": "string",
              "enum": [
                "google-fonts",
                "fontsource",
                "bundled"
              ]
            },
            "weights": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 100,
                "maximum": 900
              },
              "description": "Weights the direction uses"
            },
            "fallback": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "license",
            "source",
            "weights",
            "fallback"
          ],
          "additionalProperties": false
        },
        "scale": {
          "type": "object",
          "properties": {
            "display": {
              "type": "object",
              "properties": {
                "size": {
                  "type": "number",
                  "minimum": 10,
                  "maximum": 120,
                  "description": "px on web (base 16), sp on Android"
                },
                "weight": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 900
                },
                "line_height": {
                  "type": "number",
                  "minimum": 10,
                  "maximum": 160,
                  "description": "Absolute line height, same unit as size"
                },
                "letter_spacing": {
                  "type": "number",
                  "minimum": -0.1,
                  "maximum": 0.2,
                  "description": "em"
                },
                "family": {
                  "description": "Defaults: display/headline use display, others use body",
                  "type": "string",
                  "enum": [
                    "display",
                    "body",
                    "mono"
                  ]
                }
              },
              "required": [
                "size",
                "weight",
                "line_height",
                "letter_spacing"
              ],
              "additionalProperties": false
            },
            "headline": {
              "type": "object",
              "properties": {
                "size": {
                  "type": "number",
                  "minimum": 10,
                  "maximum": 120,
                  "description": "px on web (base 16), sp on Android"
                },
                "weight": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 900
                },
                "line_height": {
                  "type": "number",
                  "minimum": 10,
                  "maximum": 160,
                  "description": "Absolute line height, same unit as size"
                },
                "letter_spacing": {
                  "type": "number",
                  "minimum": -0.1,
                  "maximum": 0.2,
                  "description": "em"
                },
                "family": {
                  "description": "Defaults: display/headline use display, others use body",
                  "type": "string",
                  "enum": [
                    "display",
                    "body",
                    "mono"
                  ]
                }
              },
              "required": [
                "size",
                "weight",
                "line_height",
                "letter_spacing"
              ],
              "additionalProperties": false
            },
            "title": {
              "type": "object",
              "properties": {
                "size": {
                  "type": "number",
                  "minimum": 10,
                  "maximum": 120,
                  "description": "px on web (base 16), sp on Android"
                },
                "weight": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 900
                },
                "line_height": {
                  "type": "number",
                  "minimum": 10,
                  "maximum": 160,
                  "description": "Absolute line height, same unit as size"
                },
                "letter_spacing": {
                  "type": "number",
                  "minimum": -0.1,
                  "maximum": 0.2,
                  "description": "em"
                },
                "family": {
                  "description": "Defaults: display/headline use display, others use body",
                  "type": "string",
                  "enum": [
                    "display",
                    "body",
                    "mono"
                  ]
                }
              },
              "required": [
                "size",
                "weight",
                "line_height",
                "letter_spacing"
              ],
              "additionalProperties": false
            },
            "body": {
              "type": "object",
              "properties": {
                "size": {
                  "type": "number",
                  "minimum": 10,
                  "maximum": 120,
                  "description": "px on web (base 16), sp on Android"
                },
                "weight": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 900
                },
                "line_height": {
                  "type": "number",
